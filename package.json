{
  "name": "phonelinker",
  "private": true,
  "version": "1.2.1",
  "description": "Link your phone and computer in LAN",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsc&&electron ./",
    "start": "electron-forge start",
    "prep:forge": "npm run build --workspace shared && tsc && npm run build --workspace renderer && node scripts/copy-renderer-dist.js",
    "package": "npm run prep:forge && electron-forge package",
    "make": "npm run prep:forge && electron-forge make"
  },
  "author": "NativeStar",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.1.0",
    "@electron-forge/maker-rpm": "^7.1.0",
    "@electron-forge/maker-squirrel": "^7.1.0",
    "@electron-forge/maker-wix": "^7.7.0",
    "@electron-forge/maker-zip": "^7.1.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron/rebuild": "^4.0.4",
    "@felixrieseberg/electron-forge-maker-nsis": "^7.2.0",
    "@types/archiver": "^7.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jsmediatags": "^3.9.6",
    "@types/node": "^24.12.4",
    "@types/node-forge": "^1.3.14",
    "@types/qrcodejs": "^1.0.4",
    "@types/ws": "^8.18.1",
    "@types/xml-escape": "^1.1.3",
    "electron": "^42.0.0",
    "node-abi": "^4.31.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "chokidar": "^5.0.0",
    "fs-extra": "^11.3.4",
    "node-forge": "^1.4.0",
    "node-stream-zip": "^1.15.0",
    "opus-decoder": "^0.7.11",
    "randomthing-js": "^2.0.1",
    "shared": "file:shared",
    "speaker": "^0.5.5",
    "uuid": "^14.0.0",
    "windows-notification-state": "^2.0.0",
    "ws": "^8.20.0",
    "xml-escape": "^1.1.0"
  },
  "workspaces": [
    "renderer",
    "shared"
  ]
}
